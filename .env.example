# Environment (copy ke .env dan isi)
# dipake: topic_tracker.py (ADACODE), Kaggle push (KAGGLE_API_TOKEN), cron digest

# adaCODE API (topic_tracker.py — klasifikasi topik via LLM)
ADACODE_API_KEY=

# Kaggle (dataset push) — token v2 format "user=...;key=..." (KGAT_)
KAGGLE_API_TOKEN=
KAGGLE_CONFIG_DIR=/home/isra_habibi/.kaggle

# X/Twitter session (scan.py — dibaca dari creds.json, bukan env)
# creds.json format: {"auth_token":"...","ct0":"...","twid":"...","kdt":"...","bearer":"..."}
# CATATAN: file creds.json di-gitignore (secret). Export dari browser lo sendiri.

# Model digest (dipake cron Hermes, bukan env)
