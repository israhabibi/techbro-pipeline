# Copy to .env. Export variables or use techbro --env-file .env COMMAND.
DATA_DIR=./data
DATASET_DIR=./dataset
CREDS_FILE=./creds.json
SCAN_PAGES=3
ADACODE_API_KEY=
ADACODE_MODEL=adacode-2.0
ENABLE_SUPPLEMENTAL_RSS=1
ENABLE_VIDEO_RENDER=false
TTS_BACKEND=local
PEXELS_API_KEY=
# Administrator-selected local media directory, optional.
VIDEO_ASSETS_DIR=
TECHBRO_PORT=8000

# Repliz: store real keys only in the ignored local environment file.
REPLIZ_ACCESS_KEY=
REPLIZ_SECRET_KEY=
REPLIZ_ACCOUNT_ID=
# Opt in only after reviewing a preview; this schedules live Threads posts.
REPLIZ_AUTO_SCHEDULE=false
# Daily publish time in Asia/Jakarta; must be later than pipeline completion.
REPLIZ_SCHEDULE_TIME=10:00
